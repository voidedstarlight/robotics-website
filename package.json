{
	"dependencies": {
		"dotenv": "^17.4.2",
		"typescript": "^7.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tsconfig/node24": "^24.0.4",
		"@tsconfig/recommended": "^1.0.13",
		"@types/node": "^26.1.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"concurrently": "^10.0.3",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"tsc-watch": "^7.2.1",
		"typescript-eslint": "^8.63.0"
	},
	"main": "dist/server.js",
	"name": "grizzlyrobotics.org",
	"scripts": {
		"build:api": "npm run build -w @grizzlyrobotics.org/api",
		"build:web": "npm run build -w @grizzlyrobotics.org/web",
		"build": "npm run build:api && npm run build:web",
		"dev": "concurrently -n 'API,WEB' -c 'bgBlue.black,bgMagentaBright.black' 'npm run dev -w @grizzlyrobotics.org/api' 'npm run dev -w @grizzlyrobotics.org/web'",
		"lint": "eslint ."
	},
	"version": "0.0.1",
	"workspaces": [
		"packages/*"
	]
}
